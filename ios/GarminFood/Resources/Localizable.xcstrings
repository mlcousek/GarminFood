{
  "sourceLanguage": "en",
  "strings": {
    "%@ · %@": {
      "comment": "Food name · serving label.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ · %2$@"
          }
        }
      }
    },
    "%@ · %lld g carbs, %lld min before": {
      "comment": "Sport & body activity row: a fuel entry. %@ = food name, then grams, then minutes before the start.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld g sacharidů, %lld min před"
          }
        }
      }
    },
    "%@ · %lld g protein": {
      "comment": "Sport & body activity row: an entry after the activity. %@ = food name.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %lld g bílkovin"
          }
        }
      }
    },
    "%@ · carb-rich, %lld min before": {
      "comment": "Sport & body activity row: a fuel entry with unknown carbs. %@ = food name.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · bohaté na sacharidy, %lld min před"
          }
        }
      }
    },
    "%@ +%lld XP": {
      "comment": "Celebration card: a gamification feature's message (already localized) followed by the XP it awarded.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ +%lld XP"
          }
        }
      }
    },
    "%@ fast · %@ eating": {
      "comment": "Fasting schedule split, e.g. 16 h fast · 8 h eating.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ půst · %@ jídlo"
          }
        }
      }
    },
    "%@ g": {
      "comment": "An amount in grams, e.g. 25 g.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ g"
          }
        }
      }
    },
    "%@ has no serving Garmin can log.": {
      "comment": "Siri reply. %@ is a food name.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nemá žádnou porci, kterou by šlo zapsat do Garminu."
          }
        }
      }
    },
    "%@ in · eating opens at %@": {
      "comment": "Fasting card detail: elapsed, clock time eating opens.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ půstu · jídlo od %@"
          }
        }
      }
    },
    "%@ kcal": {
      "comment": "Energy of a serving, e.g. '290 kcal'. %@ = whole-number value.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kcal"
          }
        }
      }
    },
    "%@ kcal left": {
      "comment": "Calorie ring headline; %@ = whole kcal still available today.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývá %@ kcal"
          }
        }
      }
    },
    "%@ kcal over": {
      "comment": "Calorie ring headline; %@ = whole kcal above today's target.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kcal přes cíl"
          }
        }
      }
    },
    "%@ kcal, no target": {
      "comment": "Meal detail: calories eaten when the meal has no target; %@ = whole kcal.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kcal, bez cíle"
          }
        }
      }
    },
    "%@ kg": {
      "comment": "A weight in kilograms; %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kg"
          }
        }
      }
    },
    "%@ kg to go": {
      "comment": "Weight goal bar. %@ is a weight, e.g. 3.5.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývá %@ kg"
          }
        }
      }
    },
    "%@ kg to go · about %@": {
      "comment": "Weight goal bar. First %@ is a weight, second a date (estimated arrival at the goal at the current trend).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývá %1$@ kg · zhruba %2$@"
          }
        }
      }
    },
    "%@ kg to go · about %@ at Garmin's planned rate": {
      "comment": "Weight goal bar. First %@ is a weight, second a date (estimated arrival at the goal, from Garmin's weekly plan).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbývá %1$@ kg · zhruba %2$@ podle tempa naplánovaného v Garminu"
          }
        }
      }
    },
    "%@ kilocalories": {
      "comment": "VoiceOver: an energy amount, e.g. 290 (Czech: 290 kilokalorií).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kilokalorií"
          }
        }
      }
    },
    "%@ kilograms": {
      "comment": "VoiceOver: a weight with a decimal part, e.g. 83.9 (Czech: genitive singular, 83,9 kilogramu).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kilogramu"
          }
        }
      }
    },
    "%@ milliliters": {
      "comment": "VoiceOver: a water amount too large for a whole-number count (practically never).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ mililitrů"
          }
        }
      }
    },
    "%@ ml": {
      "comment": "An amount of water in millilitres; %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ml"
          }
        }
      }
    },
    "%@ of %@ kcal": {
      "comment": "Meal detail: calories eaten of the meal's target; %@ = whole kcal values.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %2$@ kcal"
          }
        }
      }
    },
    "%@ of %@ kilocalories": {
      "comment": "VoiceOver value of the calorie ring; first %@ = consumed, second %@ = target.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ z %2$@ kilokalorií"
          }
        }
      }
    },
    "%@ on %lld of 7 days to defeat it.": {
      "comment": "Weekly boss screen: the habit and the target. %@ is the habit (e.g. 'Log breakfast'), %lld a number of days.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ve %2$lld ze 7 dnů a porazíš ho."
          }
        }
      }
    },
    "%@, %@ times %@": {
      "comment": "VoiceOver label of a quick-pick card. %1$@ = food name, %2$@ = usual quantity (e.g. 2), %3$@ = serving (e.g. 100 g).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@krát %3$@"
          }
        }
      }
    },
    "%@, %@ times %@, %@ kilocalories": {
      "comment": "VoiceOver label of a quick-pick card. %1$@ = food name, %2$@ = quantity, %3$@ = serving, %4$@ = total energy (whole number).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@krát %3$@, %4$@ kilokalorií"
          }
        }
      }
    },
    "%@, %@, %@": {
      "comment": "VoiceOver label of a saved meal card: name, ingredient count ('3 ingredients'), energy with its unit spelled out.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, %3$@"
          }
        }
      }
    },
    "%@, %@, next milestone": {
      "comment": "Accessibility: journey milestone name, its amount, the next one.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@, %@, další milník"
          }
        }
      }
    },
