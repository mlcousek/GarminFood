{
  "sourceLanguage": "en",
  "strings": {
    "%@ +%lld XP": {
      "comment": "Celebration card: a gamification feature's message (already localized) followed by the XP it awarded.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ +%lld XP"
          }
        }
      }
    },
    "%@ has no serving Garmin can log.": {
      "comment": "Siri reply. %@ is a food name.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ nemá žádnou porci, kterou by šlo zapsat do Garminu."
          }
        }
      }
    },
    "%@ kcal": {
      "comment": "Energy of a serving, e.g. '290 kcal'. %@ = whole-number value.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kcal"
          }
        }
      }
    },
    "%@ kg": {
      "comment": "A weight in kilograms; %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kg"
          }
        }
      }
    },
    "%@ ml": {
      "comment": "An amount of water in millilitres; %@ is the formatted number.",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ml"
          }
        }
      }
    },
    "%@, %@ times %@": {
      "comment": "VoiceOver label of a quick-pick card. %1$@ = food name, %2$@ = usual quantity (e.g. 2), %3$@ = serving (e.g. 100 g).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@krát %3$@"
          }
        }
      }
    },
    "%@, %@ times %@, %@ kilocalories": {
      "comment": "VoiceOver label of a quick-pick card. %1$@ = food name, %2$@ = quantity, %3$@ = serving, %4$@ = total energy (whole number).",
      "extractionState": "manual",
      "localizations": {
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@krát %3$@, %4$@ kilokalorií"
          }
        }
      }
    },
    "%@, favorite": {
      "comment": "VoiceOver label of a favorite food card. %@ = food name.",
