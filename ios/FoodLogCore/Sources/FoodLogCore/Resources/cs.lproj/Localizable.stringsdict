<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  FoodLogCore plurals, Czech (add-localization design.md D3/D5):
  one / few / many (decimals) / other. Same keys as en.lproj.
-->
<plist version="1.0">
<dict>
	<!-- Fasting reminder notification body (NotificationPlanning.swift). %@ is a 24-hour clock time (HH:mm), the plural variable is the minutes until eating opens. -->
	<key>Your fast ends at %@ -- eating opens in %lld minutes.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>Tvůj půst končí v %@ – jíst můžeš za %#@minutes@.</string>
		<key>minutes</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>%lld minutu</string>
			<key>few</key>
			<string>%lld minuty</string>
			<key>many</key>
			<string>%lld minuty</string>
			<key>other</key>
			<string>%lld minut</string>
		</dict>
	</dict>
</dict>
</plist>
