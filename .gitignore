node_modules/
.serena/

# Xcode project is generated by XcodeGen from ios/project.yml on every CI
# run (see .github/workflows/build.yml) -- never commit the generated
# .xcodeproj itself, that's exactly the kind of drift-prone artifact
# XcodeGen exists to avoid.
ios/*.xcodeproj/
ios/build/
ios/DerivedData/
*.ipa

# Defensive: none of the tools currently write credential files into this
# repo, but if that ever changes, these patterns should catch it before a
# broad `git add` does.
*.env
.env.*
*token*.json
*credentials*.json
