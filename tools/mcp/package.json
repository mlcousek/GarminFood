{
  "name": "garminfood-mcp",
  "version": "0.1.0",
  "private": true,
  "description": "GarminFood's local stdio MCP server: Garmin Connect reads through the project's route registry (and, later, the phone bridge). See openspec/changes/add-mcp-server.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "garminfood-mcp": "dist/src/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.json && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "ajv": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "typescript": "^5.9.3"
  }
}
